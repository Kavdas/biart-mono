{
  "name": "biart-mono",
  "private": true,
  "scripts": {
    "start": "node -r ./tools/dns-fix.cjs node_modules/@wordpress/env/bin/wp-env start",
    "stop": "node -r ./tools/dns-fix.cjs node_modules/@wordpress/env/bin/wp-env stop",
    "update": "node -r ./tools/dns-fix.cjs node_modules/@wordpress/env/bin/wp-env start --update",
    "destroy": "node -r ./tools/dns-fix.cjs node_modules/@wordpress/env/bin/wp-env destroy",
    "wp": "node -r ./tools/dns-fix.cjs node_modules/@wordpress/env/bin/wp-env run cli wp",
    "setup": "node tools/setup.cjs",
    "seed": "node tools/seed-home.cjs",
    "deploy": "node tools/deploy-demo.cjs"
  },
  "devDependencies": {
    "@wordpress/env": "^10.0.0",
    "playwright-core": "1.52"
  }
}